# Бесплатные модели через локальный omniroute (CAPEX = 0)
# Копировать в .env при необходимости. Без API-ключа.

# OpenAI-совместимый endpoint omniroute
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Бесплатная рабочая модель (проверено: auto/best-coding, auto/best-fast отвечают;
# auto/best-reasoning может быть в rate-limit/401)
OMNI_MODEL=auto/best-coding

# Кандидаты fallback при 401/429 (через запятую)
OMNI_MODEL_CANDIDATES=auto/best-coding,auto/best-fast,auto/best-reasoning

# Таймаут inference (мс)
OMNI_TIMEOUT_MS=120000
